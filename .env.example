# ml-worker (FastAPI) 엔드포인트
WFP_WORKER_URL=http://localhost:8000

# NextAuth (운영 시 강한 랜덤값으로 교체)
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# OAuth (선택)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Gradio Playground (Stage 9 완료 후 추론 시연용)
GRADIO_BASE_URL=http://localhost:7860

# NestJS gateway (선택 — 본격 운영 시)
WFP_GATEWAY_URL=

# ─────────────────────────────────────────────
# WebSocket — 잡 진행 스트림 (worker /ws/{job_id})
# ─────────────────────────────────────────────
# 브라우저가 직접 worker WS 에 연결한다 (Next.js 는 WS proxy 안 함).
# 우선순위: NEXT_PUBLIC_WS_BASE > (페이지호스트 + NEXT_PUBLIC_WORKER_WS_PORT)
#
# 1) 명시 URL — 리버스 프록시(Traefik/nginx)가 /ws/* 를 worker 로 넘기는 운영:
#   NEXT_PUBLIC_WS_BASE=wss://wfp.example.com
# 또는 Traefik 80 진입점 + 도메인 없이 IP 운영:
#   NEXT_PUBLIC_WS_BASE=ws://192.168.8.80
#
# 2) 자동 — 페이지 호스트 + 워커 포트.
#    Next.js 가 :3000, worker 가 같은 호스트 :8000 인 직접 노출 운영에 적합.
#    호스트 protocol(http/https)에 따라 ws/wss 자동 선택.
#   NEXT_PUBLIC_WORKER_WS_PORT=8000
#
# ⚠ 이 값들은 NEXT_PUBLIC_ prefix 라 **빌드 타임** 에 inline 됨.
#   값 변경 후 반드시 `pnpm build && pnpm start` (또는 PM2 재시작).
# NEXT_PUBLIC_WS_BASE=
# NEXT_PUBLIC_WORKER_WS_PORT=8000
